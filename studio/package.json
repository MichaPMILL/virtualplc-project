{
  "name": "virtualplc-studio",
  "productName": "VirtualPLC Studio",
  "version": "0.1.0",
  "description": "Engineering software for VirtualPLC CPUs",
  "license": "BSD-3-Clause",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "web": "node build.mjs && node dev/server.mjs",
    "typecheck": "tsc --noEmit",
    "dist": "node build.mjs && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "codemirror": "^6.0.2"
  },
  "build": {
    "appId": "io.virtualplc.studio",
    "productName": "VirtualPLC Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
