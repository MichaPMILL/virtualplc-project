# systemd unit for the VirtualPLC CPU (Linux / Raspberry Pi).
# Install:
#   sudo cmake --install runtime/build            # installs /usr/local/bin/vplc-cpu
#   sudo useradd --system --groups gpio virtualplc
#   sudo install -d -o virtualplc /var/lib/virtualplc
#   sudo cp deploy/vplc-cpu.service /etc/systemd/system/ && sudo systemctl enable --now vplc-cpu
[Unit]
Description=VirtualPLC CPU
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=virtualplc
Group=virtualplc
SupplementaryGroups=gpio
# Hardened settings (docs/security.md): encrypted Studio link only, signed programs only,
# audit trail copied to syslog. Before the first start, create an administrator and trust
# the engineering key of the Studio (Sécurité > Programmes signés shows it):
#   sudo -u virtualplc vplc-cpu --data /var/lib/virtualplc --add-user admin --role admin
#   sudo -u virtualplc vplc-cpu --data /var/lib/virtualplc --trust-key alice:<public key hex>
ExecStart=/usr/local/bin/vplc-cpu --data /var/lib/virtualplc --name %H --tls-required --signed-programs --audit-syslog
# Commissioning on an isolated network only (no account, no signature):
# ExecStart=/usr/local/bin/vplc-cpu --data /var/lib/virtualplc --name %H
Restart=always
RestartSec=1
KillSignal=SIGTERM
TimeoutStopSec=5
# Real-time friendly scheduling for a steadier scan cycle
Nice=-10
# S7 communication (port 102) for HMIs: bind a port below 1024
# PROFINET: raw Ethernet frames (CAP_NET_RAW), IP address set by the controller (CAP_NET_ADMIN)
# real-time priority of the PROFINET thread (CAP_SYS_NICE)
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN CAP_SYS_NICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN CAP_SYS_NICE
LimitRTPRIO=99

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/virtualplc
DeviceAllow=/dev/gpiochip0 rw
UMask=0077
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service @network-io
SystemCallFilter=~@mount @swap @reboot @module @debug @obsolete @cpu-emulation
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_PACKET AF_NETLINK

[Install]
WantedBy=multi-user.target
