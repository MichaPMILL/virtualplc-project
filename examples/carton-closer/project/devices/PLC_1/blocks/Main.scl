REGION Séquence (commande les vérins par leurs méthodes)
    "Machine"(Start := "BP_Start", Stop := "BP_Stop", EmergencyOk := "AU_Ok", Reset := "BP_Reset",
              BoxAtStation := "B_BoxAtStation", BoxOut := "B_BoxOut",
              Stopper := "Stopper", SideFlaps := "SideFlaps", FrontFlaps := "FrontFlaps", Press := "Press",
              ConveyorIn => "M_ConveyorIn", ConveyorOut => "M_ConveyorOut", Glue => "YV_Glue",
              Running => "H_Running", FaultLamp => "H_Fault", Count => "BoxCount");
END_REGION

REGION Vérins (capteurs -> distributeurs)
    "Stopper"(SensorOut := "B_Stopper_Out", SensorIn := "B_Stopper_In", Valve => "YV_Stopper");
    "SideFlaps"(SensorOut := "B_SideFlaps_Out", SensorIn := "B_SideFlaps_In", Valve => "YV_SideFlaps");
    "FrontFlaps"(SensorOut := "B_FrontFlaps_Out", Valve => "YV_FrontFlaps");
    "Press"(SensorOut := "B_Press_Out", SensorIn := "B_Press_In", Valve => "YV_PressDown", ValveIn => "YV_PressUp");
END_REGION
